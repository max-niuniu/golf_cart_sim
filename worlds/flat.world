<?xml version="1.0"?>
<sdf version="1.6"><world name="default">
  <gravity>0 0 -9.81</gravity>
  <physics type="ode" name="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate>
    <ode><solver><type>world</type></solver>
      <constraints><cfm>0.00001</cfm><erp>0.2</erp><contact_max_correcting_vel>1</contact_max_correcting_vel><contact_surface_layer>0.001</contact_surface_layer></constraints>
    </ode>
  </physics>
  <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.7 0.8 0.9 1</background><shadows>true</shadows></scene>
  <light name="sun" type="directional"><cast_shadows>true</cast_shadows><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.2 -1</direction></light>
  <model name="ground"><static>true</static><link name="ground">
